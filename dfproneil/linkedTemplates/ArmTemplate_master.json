{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfproneil"
		},
		"linkservice_Database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linkservice_Database'"
		},
		"linkservice_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkservice_datalake'"
		},
		"LS_restAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"linkservice_Database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dfproneil.database.windows.net"
		},
		"linkservice_Database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dfproserver"
		},
		"linkservice_Database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "neiladmin"
		},
		"linkservice_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://fabricdatafactoryneil.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfproneil_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkservice_Database_password": {
						"value": "[parameters('linkservice_Database_password')]"
					},
					"linkservice_datalake_accountKey": {
						"value": "[parameters('linkservice_datalake_accountKey')]"
					},
					"LS_restAPI_properties_typeProperties_url": {
						"value": "[parameters('LS_restAPI_properties_typeProperties_url')]"
					},
					"linkservice_Database_properties_typeProperties_server": {
						"value": "[parameters('linkservice_Database_properties_typeProperties_server')]"
					},
					"linkservice_Database_properties_typeProperties_database": {
						"value": "[parameters('linkservice_Database_properties_typeProperties_database')]"
					},
					"linkservice_Database_properties_typeProperties_userName": {
						"value": "[parameters('linkservice_Database_properties_typeProperties_userName')]"
					},
					"linkservice_datalake_properties_typeProperties_url": {
						"value": "[parameters('linkservice_datalake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}